# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL
POSTGRES_USER=obrolin
POSTGRES_PASSWORD=obrolin
DATABASE_HOST=localhost
DATABASE_PORT=5433

# MongoDB
MONGODB_URL=mongodb://localhost:27017/obrolin_development

# Redis (separate logical DBs per concern)
REDIS_URL=redis://localhost:6379/0
REDIS_CABLE_URL=redis://localhost:6379/1
REDIS_SIDEKIQ_URL=redis://localhost:6379/2

# Auth: generate with `openssl rand -hex 64`
JWT_SECRET=change-me
JWT_TTL_MINUTES=1440

# Origins allowed for CORS and ActionCable (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the frontend, used in invitation links
FRONTEND_URL=http://localhost:5173
