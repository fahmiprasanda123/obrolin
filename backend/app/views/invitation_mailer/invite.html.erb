<h2>Join <%= @workspace.name %> on Obrolin</h2>
<p><strong><%= @inviter.display_name %></strong> (@<%= @inviter.username %>) invited you to the
  <strong><%= @workspace.name %></strong> workspace.</p>
<p><a href="<%= @invitation.url %>">Accept invitation</a></p>
<p style="color:#666">This link expires on <%= @invitation.expires_at.to_fs(:long) %>.
  If you don't have an account yet, sign up with <%= @invitation.email %>.</p>
